# Database
DATABASE_URL=postgresql://user:password@192.168.4.20:5432/grocery_list

# NextAuth
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=https://grocery.whitetailnas.app

# VAPID Keys for Push Notifications
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# Optional: For public client-side access to VAPID key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Cron Secret (for securing the notification endpoint)
CRON_SECRET=your-cron-secret-here
