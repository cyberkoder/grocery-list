generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String              @id @default(cuid())
  name             String
  email            String              @unique
  password         String
  isAdmin          Boolean             @default(false)
  pushSubscription String?             @db.Text
  notifyAt9am      Boolean             @default(true)
  notifyOnChanges  Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  items            Item[]
  shoppingTrips    ShoppingTrip[]
  households       HouseholdMember[]
  sentInvites      HouseholdInvite[]
}

model Household {
  id        String            @id @default(cuid())
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   HouseholdMember[]
  invites   HouseholdInvite[]
  items     Item[]
  trips     ShoppingTrip[]
}

model HouseholdMember {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  role        String    @default("member") // owner, admin, member
  joinedAt    DateTime  @default(now())

  @@unique([userId, householdId])
  @@index([userId])
  @@index([householdId])
}

model HouseholdInvite {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@index([householdId])
}

model Store {
  id          String        @id @default(cuid())
  name        String        @unique
  icon        String?
  order       Int
  createdAt   DateTime      @default(now())
  items       Item[]
  itemHistory ItemHistory[]
}

model Category {
  id          String        @id @default(cuid())
  name        String        @unique
  icon        String?
  order       Int
  createdAt   DateTime      @default(now())
  items       Item[]
  itemHistory ItemHistory[]
}

model Item {
  id          String     @id @default(cuid())
  name        String
  quantity    Int        @default(1)
  unit        String?
  note        String?
  checked     Boolean    @default(false)
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  addedById   String
  addedBy     User       @relation(fields: [addedById], references: [id], onDelete: Cascade)
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([storeId])
  @@index([categoryId])
  @@index([addedById])
  @@index([householdId])
  @@index([checked])
}

model ItemHistory {
  id                   String           @id @default(cuid())
  name                 String           @unique
  categoryId           String
  category             Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  storeId              String?
  store                Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  defaultQuantity      Int              @default(1)
  defaultUnit          String?
  addCount             Int              @default(1)
  lastAddedAt          DateTime         @default(now())
  createdAt            DateTime         @default(now())
  imageUrl             String?
  purchaseIntervalDays Int?
  isRecurring          Boolean          @default(false)
  purchases            PurchaseRecord[]

  @@index([addCount])
  @@index([lastAddedAt])
  @@index([isRecurring])
}

model ShoppingTrip {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId String?
  household   Household?       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  completedAt DateTime         @default(now())
  itemCount   Int              @default(0)
  createdAt   DateTime         @default(now())
  purchases   PurchaseRecord[]

  @@index([userId])
  @@index([householdId])
  @@index([completedAt])
}

model PurchaseRecord {
  id            String        @id @default(cuid())
  tripId        String
  trip          ShoppingTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itemHistoryId String?
  itemHistory   ItemHistory?  @relation(fields: [itemHistoryId], references: [id], onDelete: SetNull)
  name          String
  quantity      Int           @default(1)
  unit          String?
  categoryName  String
  storeName     String
  purchasedAt   DateTime      @default(now())

  @@index([tripId])
  @@index([purchasedAt])
}
